# =============================================================================
#  Bale Instagram Downloader — environment file
#  This file is generated by the installer (/install.php).
#  NEVER commit the real .env to git. Permissions must be 0600.
# =============================================================================

APP_NAME="Bale Instagram Downloader"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Tehran
# 32+ random characters. Used for CSRF/session/versioning salts.
APP_KEY=change-me-to-a-long-random-string

# --- Database ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bale_ig
DB_USER=bale_ig
DB_PASS=change-me

# --- Bale bot (https://tapi.bale.ai/bot<TOKEN>/<METHOD>) --------------------
BALE_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai
BALE_WEBHOOK_SECRET=
# Only these numeric ids can use the in-bot admin commands (comma separated).
BALE_ADMIN_IDS=

# --- Instagram provider (fast-creat compatible) -----------------------------
IG_API_KEY=
IG_API_URL=https://api.fast-creat.ir/instagram

# --- Runtime ----------------------------------------------------------------
BOT_MODE=polling

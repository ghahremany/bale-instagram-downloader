# Bale Instagram Downloader — web root hardening (Apache)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (enable once a certificate is installed)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Never serve dotfiles or backups
    RewriteRule (^|/)\. - [F]
    RewriteRule \.(env|log|sql|bak|ini|md)$ - [F]
</IfModule>

<FilesMatch "^(\.env|composer\.(json|lock)|.*\.(sql|log|md|bak|ini))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header set Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'"
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors off
    php_flag expose_php off
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

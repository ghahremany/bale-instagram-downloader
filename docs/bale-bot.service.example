# /etc/systemd/system/bale-bot.service
# sudo systemctl daemon-reload && sudo systemctl enable --now bale-bot
[Unit]
Description=Bale Instagram Downloader bot (long polling)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/bale-instagram-downloader
ExecStart=/usr/bin/php /var/www/bale-instagram-downloader/cli/poll.php
Restart=always
RestartSec=5
StandardOutput=append:/var/www/bale-instagram-downloader/storage/logs/poll.log
StandardError=append:/var/www/bale-instagram-downloader/storage/logs/poll.log

# basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
